
 
<% switch(data.type) { 
    case "blog-post" :%>
        <article class = "article">
            <h1 class="article__title"><%= data.title %></h1>
            <div class="article__body">
            <% if (data.cover_path !== "") { %>
                <img class="article__img"src="/uploads/<%= data.cover_path %>" height="200" alt="">
            <%}%>
                <%- data.body %>
            </div>
        </article>

    <% break;
    case "blog-post-embed":%>
        <article class = "article">
            <h1 class="article__title"><%= data.title %></h1>
            <div class="article__insta"><%- data.insta_link %></div>
            <div class="article__body"><%- data.body %></div>
        </article>
    <% break;

    case "mini-jam" :%>
        <article>
            <h1 class="article__title"><%= data.title %></h1>
            <% if (data.cover_path !== "") { %>
                <img class="article__img"src="/uploads/<%= data.cover_path %>" height="200" alt="">
            <%}%>
            <div class="article__audio">
                <audio src="/uploads/<%- data.audio_path %>" controls></audio>
            </div>
            <div class="article__body"><%- data.body %></div>
        </article>

    <% break;
    case "mini-jam-embed" : %>
        <article class = "article">
            <h1 class="article__title"><%= data.title %></h1>
            <div class="article__soundcloud"><%- data.soundcloud_link %></div>
            <div class="article__body"><%- data.body %></div>
        </article>

    <% break;
    case "video" : %>
    <article>
            <h1 class="article__title"><%= data.title %></h1>
            <% if (data.cover_path !== "") { %>
                 <img class="article__img"src="/uploads/<%= data.cover_path %>" height="200" alt="">
            <%}%>
            <div class="article__video">
                <video src="/uploads/<%- data.video_path %>" controls></video>
            </div>
            <div class="article__body"><%- data.body %></div>
        </article>
    <% break;
    case "video-embed" : %>
        <article class = "article">
            <h1 class="article__title"><%= data.title %></h1>
            <div class="article__youtube"><%- data.youtube_link %></div>
            <div class="article__body"><%- data.body %></div>
        </article>

    <% break;
    case "game" : %>
        <h1 class="article__title"><%= data.title %></h1>
            <% if (data.cover_path !== "") { %>
                <img class="article__img"src="/uploads/<%= data.cover_path %>" height="200" alt="">
            <%}%>
            <div class="article__game">
                <iframe src="/uploads/<%- data.game_path %>" frameborder="0" height="500px"></iframe>
            </div>
            <div class="article__body"><%- data.body %></div>
        </article>
    <% break;
} %>
