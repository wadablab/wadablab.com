<a href="/add-post">&larr; Back</a>
<div class="admin-title">
    <h1>Add New Post</h1>
</div>

<form action="/add-blog-post" method="POST" enctype="multipart/form-data">
    

    <label for="title"><h2>Title</h2></label>
    <input type="text" placeholder="Post Title" name="title">

    <label for="cover"><h2>Cover</h2></label>
    <input type="file" name="cover">

    <label for="body"><h2>Content</h2></label>
    <textarea placeholder="Blog your heart out"   cols="50" rows="10" name="body" ></textarea>

    

    <input type="submit" value="POST" class="btn">
</form>