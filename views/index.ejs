<h1>HELLO</h1>

<section class="articles">
    <h2 class="articles__heading">Latest Posts :</h2>
    <ul class = "article__ul">
        <% data.forEach(post => { %>
            <li >
                <a class = "post" href="/post/<%= post._id %>"><% data.forEach(post => { %>
                 
                <% }) %>
                    <% if (post.cover_path !== "") { %>
                        <img class="article__img"src="/uploads/<%= post.cover_path  %>"alt="">
                    <% } else {%>
                         <img class="article__img"src="/uploads/no_image.png"alt="">

                    <% } %>
                    <span class="article-list__title"><%= post.title %></span>
                    <span class="article-list__date"><%= post.createdAt.toDateString() %></span>
                </a>  
                    
            </li>
        <% }) %>
    </ul>
e
    <% if (nextPage !== null) { %>
        <a href="/?page=<%= nextPage %>" class="pagination">&lt; View Older Posts</a>
    <% } %>


    
</section>