


<div class = "gallery-1">

    <h1 id="h1">ART GALLERY</h1>

    <div class = "canvas">
        <canvas id="myCanvas"></canvas>
        <button id="clearButton">Clear</button>
    </div>
    <form action="/gallery" method="POST" enctype="multipart/form-data">
        <label for="title"><h2>Title</h2></label>
        <textarea  id = "title" name="title" placeholder="Give your masterpiece a title" cols="20" rows="1"></textarea>

        <input  id = "cover_path" type="hidden" name="cover_path" value="">

        <input id = "postButton" type="submit" value="POST" class="btn">
    </form>
</div>


<div class="gallery-2">
    <% data.forEach(drawing => { %>
        
        <div class= "gallery_elt">
            <img src=<%= drawing.cover_path %> alt=""><br>
            <p><%= drawing.title %></p>
        </div>
        

    <% }) %>
</div>








<script>
    const canvas = document.getElementById("myCanvas");
    let context = canvas.getContext("2d");
    let BB = canvas.getBoundingClientRect();
    let isDrawing = false;
    resizeCanvas();

    function startDrawing(event) {
        event.preventDefault();
        isDrawing = true;
        draw(event);
    }
    function draw(event) {
        event.preventDefault();
        if (!isDrawing) return;
        const x = event.pageX - BB.left;
        const y = event.pageY - BB.top;
        context.lineTo(x, y);
       
        context.stroke();
    }
    function draw_phone(event) {
        event.preventDefault();
        if (!isDrawing) return;
        const x = event.changedTouches[0].pageX - BB.left;
        const y = event.changedTouches[0].pageY - BB.top;
        context.lineTo(x, y);
       
        context.stroke();
    }
    function stopDrawing() {
        event.preventDefault();
        isDrawing = false;
        context.beginPath();
    }



    function upload() {
        
        try{
            const locals = {
                title:"wadablab.com",
                description: "where worms can feel at home"
             }   
            const title = document.getElementById("title");
            const cover_path = canvas.toDataURL("image/png");
            context.clearRect(0, 0, canvas.width, canvas.height);
            const body = document.getElementById("cover_path");
            body.value = cover_path;

        } catch(error) {
            console.log(error);
        }
    }


    function resizeCanvas() {
        //resize canvas

        if(window.innerHeight >= (9*window.innerWidth/16)) {
            canvas.width  = window.innerWidth*0.5;
            canvas.height = Math.floor(9*canvas.width/16);
        }
        else {
            canvas.height = window.innerHeight*0.5;
            canvas.width  = Math.floor(16*canvas.height/9);
        }
        if (window.innerWidth <= 800){
            canvas.width  = window.innerWidth*0.95;
            canvas.height = Math.floor(9*canvas.width/16);
        }
        context = canvas.getContext("2d");
        BB = canvas.getBoundingClientRect();
    }

    window.onload = function () {
        window.scrollTo(0, 0);
        return;
    }   

    canvas.addEventListener("mousedown", startDrawing);
    canvas.addEventListener("mousemove", draw);
    canvas.addEventListener("mouseup", stopDrawing);
    canvas.addEventListener("mouseout", stopDrawing);

    canvas.addEventListener("touchstart", startDrawing);
    canvas.addEventListener("touchend", stopDrawing);
    canvas.addEventListener("touchmove", draw_phone);
    canvas.addEventListener("touchout", stopDrawing);

    const clearButton = document.getElementById("clearButton");
    const postButton = document.getElementById("postButton");
    clearButton.addEventListener("click", function() {
        context.clearRect(0, 0, canvas.width, canvas.height);
    });
    postButton.addEventListener("click", upload);
</script>